<?xml version="1.0" encoding="utf-8"?>
<LinearLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#0C0D12"
    android:orientation="vertical"
    android:paddingBottom="16dp">

    <!-- 1. Post Header: Creator Info -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp">

        <!-- Circular Creator Avatar -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivCreatorAvatar"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:scaleType="centerCrop"
            android:src="@android:drawable/sym_def_app_icon"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
            app:strokeColor="#FF3366"
            app:strokeWidth="1.5dp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="12dp"
            android:layout_toEndOf="@id/ivCreatorAvatar"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvCreatorName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-bold"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    tools:text="aryan_sharma" />

                <!-- VIP Exclusive Badge -->
                <TextView
                    android:id="@+id/badgeExclusiveCreator"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="#25FF3366"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:text="👑 VIP"
                    android:textColor="#FF3366"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    tools:visibility="visible" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvTimeAgo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2h ago"
                android:textColor="#808090"
                android:textSize="11sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btnMoreOptions"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="6dp"
            android:src="@android:drawable/ic_menu_more"
            app:tint="#A0A0B0"
            android:contentDescription="More" />
    </RelativeLayout>

    <!-- 2. Media Container (Image/Video + Crucial Subscription Paywall Overlay) -->
    <FrameLayout
        android:id="@+id/flMediaContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#050508">

        <!-- Content Media (Photo / Video Poster) -->
        <ImageView
            android:id="@+id/ivPostMedia"
            android:layout_width="match_parent"
            android:layout_height="400dp"
            android:scaleType="centerCrop"
            android:contentDescription="Post Media" />

        <!-- Video Indicator Icon (Shown if post is video) -->
        <ImageView
            android:id="@+id/ivVideoIndicator"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="top|end"
            android:layout_margin="12dp"
            android:background="#80000000"
            android:padding="6dp"
            android:src="@android:drawable/ic_media_play"
            app:tint="#FFFFFF"
            android:visibility="gone"
            tools:visibility="visible"
            android:contentDescription="Video Content" />

        <!-- ========================================================================= -->
        <!-- 🔒 CRUCIAL: PAYWALL OVERLAY FOR EXCLUSIVE CREATOR CONTENT                 -->
        <!-- (Visible ONLY when post.isExclusive == true AND user is NOT subscribed)    -->
        <!-- ========================================================================= -->
        <RelativeLayout
            android:id="@+id/flExclusiveOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#D9080810"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:padding="24dp"
            android:visibility="gone"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical">

                <!-- Glowing Lock Icon Halo -->
                <FrameLayout
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:background="@drawable/shape_lock_halo">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="🔒"
                        android:textSize="36sp" />
                </FrameLayout>

                <!-- Exclusive Badge Title -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:fontFamily="sans-serif-black"
                    android:text="Creator Exclusive Post"
                    android:textColor="#FFFFFF"
                    android:textSize="19sp" />

                <!-- Subtitle -->
                <TextView
                    android:id="@+id/tvExclusiveDescription"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:lineSpacingExtra="2dp"
                    android:text="This post is reserved exclusively for subscribers. Subscribe now to unblur media and view full content."
                    android:textColor="#C0C0D0"
                    android:textSize="13sp" />

                <!-- Perks Pill -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="#15FFFFFF"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="4dp"
                    android:text="✨ 100% Unlocked Media • VIP Creator Chat"
                    android:textColor="#D8B4FE"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <!-- Bright Call To Action Button -->
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnSubscribeToUnlock"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/btn_gradient_subscribe"
                    android:fontFamily="sans-serif-bold"
                    android:minWidth="200dp"
                    android:paddingHorizontal="24dp"
                    android:text="Subscribe to Unlock (₹99/mo)"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />
            </LinearLayout>
        </RelativeLayout>
    </FrameLayout>

    <!-- 3. Actions Bar (Like, Comment, Share, Bookmark) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingTop="12dp">

        <ImageView
            android:id="@+id/btnLike"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/star_big_off"
            app:tint="#FFFFFF"
            android:contentDescription="Like" />

        <ImageView
            android:id="@+id/btnComment"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="16dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_send"
            app:tint="#FFFFFF"
            android:contentDescription="Comment" />

        <ImageView
            android:id="@+id/btnShare"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="16dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_share"
            app:tint="#FFFFFF"
            android:contentDescription="Share" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/btnBookmark"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_input_add"
            app:tint="#FFFFFF"
            android:contentDescription="Save" />
    </LinearLayout>

    <!-- 4. Likes & Caption -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="14dp"
        android:paddingTop="6dp">

        <TextView
            android:id="@+id/tvLikesCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-bold"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            tools:text="1,240 likes" />

        <TextView
            android:id="@+id/tvCaption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:lineSpacingExtra="2dp"
            android:textColor="#E0E0E6"
            android:textSize="13sp"
            tools:text="Excited to share this behind-the-scenes shot with my VIP subscribers! ❤️" />
    </LinearLayout>

</LinearLayout>
